<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets Pulse open the Google Health app (Share heart rate lives there). -->
  <queries>
    <package android:name="com.fitbit.FitbitMobile" />
  </queries>

  <application>
    <!-- The two 2x1 home-screen widgets (java/app/pulse/bt/PulseWidgets.kt). -->
    <receiver
        android:name="app.pulse.bt.HeartStrainWidget"
        android:exported="false"
        android:label="@string/pulse_widget_heart_strain_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/pulse_widget_heart_strain" />
    </receiver>
    <receiver
        android:name="app.pulse.bt.FuelWidget"
        android:exported="false"
        android:label="@string/pulse_widget_fuel_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/pulse_widget_fuel" />
    </receiver>
  </application>
</manifest>
